# Kopiere diese Datei nach .env und trage deine Keys ein. Die .env wird nie committet.

# Stimme: ElevenLabs Agents (Agent-ID bekommst du nach `npm run push:agent` in agents/jarvis)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: EU-Datenresidenz (nur mit EU-Workspace). Dann im HUD zusätzlich
# NEXT_PUBLIC_ELEVENLABS_SERVER_LOCATION=eu-residency setzen (apps/hud/.env.local).
# ELEVENLABS_API_BASE=https://api.eu.residency.elevenlabs.io

# Gehirn (Claude). Ist REQUESTY_API_KEY gesetzt, laufen Orchestrator und CU-Worker über
# Requesty (Modell-IDs bekommen automatisch das Präfix "anthropic/").
# ANTHROPIC_API_KEY ist der direkte Weg und wird für Computer Use im Pixel-Modus gebraucht.
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai   # EU: https://router.eu.requesty.ai
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-haiku-5-5
CU_MODEL=claude-haiku-5-5

# Wie Jarvis dich anspricht
DEMO_USER_NAME=Leo

# Ports (siehe packages/contracts/src/ports.ts)
ORCHESTRATOR_URL=http://localhost:8787
MOCK_WORLD_URL=http://localhost:8700
CU_WORKER_URL=http://localhost:8800
# Optional: eigener Telefonie-Dienst für place_call (nicht enthalten)
# VOICE_AGENT_URL=http://localhost:8900
