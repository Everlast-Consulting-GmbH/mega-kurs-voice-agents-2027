# Kopiere diese Datei nach apps/hud/.env.local, wenn du etwas ändern willst. Alle Werte sind optional.

# Voice layer: elevenlabs (default) | mock (development without keys)
NEXT_PUBLIC_VOICE_PROVIDER=elevenlabs
# Public agent id is optional; the server route prefers ELEVENLABS_AGENT_ID from the root .env
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# websocket (signed URL, default) | webrtc (conversation token)
NEXT_PUBLIC_ELEVENLABS_TRANSPORT=websocket
# Leave empty for the global ElevenLabs host; "eu-residency" for an EU workspace
# (together with ELEVENLABS_API_BASE=https://api.eu.residency.elevenlabs.io in the root .env)
NEXT_PUBLIC_ELEVENLABS_SERVER_LOCATION=
# Name Jarvis uses for you in the demo data
NEXT_PUBLIC_DEMO_USER_NAME=Leo
# Orchestrator: event stream and tool gateway (client tools POST /tools/{name})
NEXT_PUBLIC_EVENTS_URL=ws://localhost:8787/events?sessionId=demo
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8787
# Mock world REST API for the app windows; "off" forces the built-in demo data
NEXT_PUBLIC_MOCK_WORLD_URL=http://localhost:8700

# Server-only, read by /api/elevenlabs/session from the ROOT .env (never sent to the browser):
#   ELEVENLABS_API_KEY, ELEVENLABS_AGENT_ID, optional ELEVENLABS_API_BASE
#   (default https://api.elevenlabs.io). JARVIS_ENV_FILE overrides the path.
