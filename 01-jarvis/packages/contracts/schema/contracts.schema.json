        },
        {
          "$ref": "#/$defs/ToolStartedEvent"
        },
        {
          "$ref": "#/$defs/ToolFinishedEvent"
        },
        {
          "$ref": "#/$defs/TaskCreatedEvent"
        },
        {
          "$ref": "#/$defs/TaskProgressEvent"
        },
        {
          "$ref": "#/$defs/TaskDoneEvent"
        },
        {
          "$ref": "#/$defs/TaskFailedEvent"
        },
        {
          "$ref": "#/$defs/CuFrameEvent"
        },
        {
          "$ref": "#/$defs/CuActionEvent"
        },
        {
          "$ref": "#/$defs/CuModeEvent"
        },
        {
          "$ref": "#/$defs/CallStateEvent"
        },
        {
          "$ref": "#/$defs/ApprovalRequestedEvent"
        },
        {
          "$ref": "#/$defs/ApprovalResolvedEvent"
        },
        {
          "$ref": "#/$defs/UiFocusEvent"
        },
        {
          "$ref": "#/$defs/UiWidgetEvent"
        },
        {
          "$ref": "#/$defs/BriefingItemEvent"
        },
        {
          "$ref": "#/$defs/MetricsLatencyEvent"
        },
        {
          "$ref": "#/$defs/ToolLearnedEvent"
        },
        {
          "$ref": "#/$defs/NoticeEvent"
        },
        {
          "$ref": "#/$defs/RunPlannedEvent"
        },
        {
          "$ref": "#/$defs/AgentSpawnedEvent"
        },
        {
          "$ref": "#/$defs/AgentActionEvent"
        },
        {
          "$ref": "#/$defs/AgentFinishedEvent"
