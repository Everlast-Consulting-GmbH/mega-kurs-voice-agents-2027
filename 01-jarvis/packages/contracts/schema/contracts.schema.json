      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "voice.state"
        },
        "payload": {
          "$ref": "#/$defs/VoiceStatePayload"
        }
      },
      "required": [
        "id",
        "ts",
        "sessionId",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "VoiceStatePayload": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/VoiceState"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
