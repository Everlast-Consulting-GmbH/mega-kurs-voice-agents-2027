    "event": {
      "$ref": "#/$defs/JarvisEvent"
    },
    "lead": {
      "$ref": "#/$defs/Lead"
    },
    "email": {
      "$ref": "#/$defs/Email"
    },
    "calendarEvent": {
      "$ref": "#/$defs/CalendarEvent"
    },
    "chatMessage": {
      "$ref": "#/$defs/ChatMessage"
