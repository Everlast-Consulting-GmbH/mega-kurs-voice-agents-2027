        "action": {
          "$ref": "#/$defs/CuActionKind"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "target": {
          "description": "Bounding box of the element being targeted, screen pixels",
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
