          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "text": {
          "description": "Typed text or key name",
          "type": "string"
        },
        "caption": {
          "type": "string",
          "description": "German subtitle, e.g. Klicke auf 'Neuer Termin'"
