# Vorlage für deine .env. Kopieren nach .env, die .env steht in .gitignore und kommt nie ins Git.
# Für den Betrieb auf AWS legt Claude dieselben Werte zusätzlich im Secrets Manager ab.

# --- AWS ---
# Name des SSO-Profils aus "aws configure sso"
AWS_PROFILE=
# Frankfurt: eu-central-1
AWS_REGION=

# --- Azure OpenAI (oder unten OpenAI direkt) ---
# Endpoint deiner Azure-OpenAI-Ressource, z. B. https://<DEINE_RESSOURCE>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment-Name für GPT-Live (Global Standard, Sweden Central)
AZURE_OPENAI_REALTIME_DEPLOYMENT=
# Deployment-Name für gpt-6-luna über die Responses-API (Tools und Judge)
AZURE_OPENAI_RESPONSES_DEPLOYMENT=
# API-Version, die Claude beim Anlegen der Deployments ermittelt
AZURE_OPENAI_API_VERSION=

# --- Alternative: OpenAI direkt statt Azure ---
OPENAI_API_KEY=

# --- LiveKit Cloud (EU-Region) ---
# Füllt "lk app env" für dich aus, z. B. wss://<DEIN_PROJEKT>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# ID des ausgehenden SIP-Trunks in LiveKit (ab Prompt 11)
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# --- Twilio (ab Prompt 11) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Deine deutsche Absendernummer im Format +49...
TWILIO_PHONE_NUMBER=
# Domain des Elastic SIP Trunks, z. B. <DEIN_TRUNK>.pstn.twilio.com
TWILIO_SIP_TRUNK_DOMAIN=

# --- Sicherheitsnetz ---
# Kommagetrennte eigene Testnummern. Bis zur rechtlichen Prüfung wählt der Dispatcher nur diese.
ALLOWED_TEST_NUMBERS=
