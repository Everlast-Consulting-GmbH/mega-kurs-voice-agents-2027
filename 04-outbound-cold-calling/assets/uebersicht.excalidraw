[[0, 0], [629.716622818341, -3.4491446721985994]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "buwj6HHJuwE2rGzc2BdP6", "type": "line", "x": 6000.794901515698, "y": 5952.9440746079445, "width": 363.8341342588781, "height": 5.285808264734764, "angle": 0, "strokeColor": "#a5d8ff", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "solid", "roughness": 2, "opacity": 100, "groupIds": [], "frameId": null, "index": "bhX", "roundness": {"type": 2}, "seed": 81884605, "version": 982, "versionNonce": 2092391086, "isDeleted": false, "boundElements": [], "updated": 1792148958336, "link": null, "locked": false, "points": [[0, 0], [363.8341342588781, -5.285808264734764]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "DzAOiGOxiaonPQvpkFmmY", "type": "line", "x": 6004.887617570399, "y": 8549.10727612788, "width": 504.49260804769165, "height": 6.322285821970581, "angle": 0, "strokeColor": "#a5d8ff", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "solid", "roughness": 2, "opacity": 100, "groupIds": [], "frameId": null, "index": "bhY", "roundness": {"type": 2}, "seed": 1264081830, "version": 1399, "versionNonce": 1322864242, "isDeleted": false, "boundElements": [], "updated": 1792223682956, "link": null, "locked": false, "points": [[0, 0], [504.49260804769165, -6.322285821970581]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "V_o_v0OpI7yCh0OGfJlVI", "type": "text", "x": 6000.794901515698, "y": 5016.770652972791, "width": 1142.311279296875, "height": 181.72577833941776, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bi2", "roundness": null, "seed": 1905524780, "version": 4, "versionNonce": 1155901746, "isDeleted": false, "boundElements": [], "updated": 1792148834722, "link": null, "locked": false, "text": "Ein KI-Telefonagent, der Leads aktiv anruft, sie mit wenigen\nFragen qualifiziert und bei Interesse direkt einen Termin mit dem\nVertrieb einträgt. Er gibt sich zu Beginn als KI zu erkennen und\nrespektiert jeden Wunsch, nicht mehr angerufen zu werden.", "fontSize": 36.34515566788355, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Ein KI-Telefonagent, der Leads aktiv anruft, sie mit wenigen\nFragen qualifiziert und bei Interesse direkt einen Termin mit dem\nVertrieb einträgt. Er gibt sich zu Beginn als KI zu erkennen und\nrespektiert jeden Wunsch, nicht mehr angerufen zu werden.", "autoResize": true, "lineHeight": 1.25}, {"id": "utsKzhloVBkTLtsjqRIl6", "type": "text", "x": 6001.1767501772965, "y": 5335.035453878948, "width": 1173.9271240234375, "height": 181.72577833941776, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bi3", "roundness": null, "seed": 1578834616, "version": 137, "versionNonce": 1805920690, "isDeleted": false, "boundElements": [], "updated": 1792148935764, "link": null, "locked": false, "text": "Dein Vertrieb telefoniert nur noch mit Leads, die wirklich\nInteresse haben, statt Stunden mit Kaltakquise zu verbringen.\nDu generierst Leads per Voice Agent in der von Everlast erstmals-\nempfohlenen \"goldenen Phase\" (Q4 2026 - Q4 2027).", "fontSize": 36.34515566788355, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Dein Vertrieb telefoniert nur noch mit Leads, die wirklich\nInteresse haben, statt Stunden mit Kaltakquise zu verbringen.\nDu generierst Leads per Voice Agent in der von Everlast erstmals-\nempfohlenen \"goldenen Phase\" (Q4 2026 - Q4 2027).", "autoResize": true, "lineHeight": 1.25}, {"id": "Ru_nFWlS8M3vhnme9Qy_N", "type": "text", "x": 6000.794901515698, "y": 5640.7121330497, "width": 1092.8525390625, "height": 227.1572229242722, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bi4", "roundness": null, "seed": 1056945477, "version": 4, "versionNonce": 1014460146, "isDeleted": false, "boundElements": [], "updated": 1792148940030, "link": null, "locked": false, "text": "- Outbound-Agent mit GPT-Live, der menschlich klingt\n- Füllwörter gezielt einsetzen und erkennen, wo sie schaden\n- Leads nach festen Regeln statt nach Bauchgefühl bewerten\n- KI-Hinweis und Opt-out sauber umsetzen\n- Self-Learning-Loop: KI verbessert den eigenen Prompt", "fontSize": 36.34515566788355, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "- Outbound-Agent mit GPT-Live, der menschlich klingt\n- Füllwörter gezielt einsetzen und erkennen, wo sie schaden\n- Leads nach festen Regeln statt nach Bauchgefühl bewerten\n- KI-Hinweis und Opt-out sauber umsetzen\n- Self-Learning-Loop: KI verbessert den eigenen Prompt", "autoResize": true, "lineHeight": 1.25}, {"id": "O6xku7CZCuTgWqEeIVhJQ", "type": "text", "x": 6004.887617570399, "y": 8578.336226319847, "width": 1007.2719116210938, "height": 318.0201120939811, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#a5d8ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bi5", "roundness": null, "seed": 753832565, "version": 195, "versionNonce": 461957358, "isDeleted": false, "boundElements": [], "updated": 1792223698017, "link": null, "locked": false, "text": "1. Vor jedem Anruf Sperrliste und Zeitfenster prüfen\n2. Hinweis, dass eine KI anruft, und Frage nach Erlaubnis\n3. Kurze Qualifizierungsfragen stellen\n4. Kontaktdaten erfassen und bestätigen\n5. Bei Interesse Termin mit dem Vertrieb eintragen\n6. Lead automatisch als heiß, warm oder kalt einstufen\n7. Bei Widerspruch die Nummer sperren", "fontSize": 36.34515566788355, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1. Vor jedem Anruf Sperrliste und Zeitfenster prüfen\n2. Hinweis, dass eine KI anruft, und Frage nach Erlaubnis\n3. Kurze Qualifizierungsfragen stellen\n4. Kontaktdaten erfassen und bestätigen\n5. Bei Interesse Termin mit dem Vertrieb eintragen\n6. Lead automatisch als heiß, warm oder kalt einstufen\n7. Bei Widerspruch die Nummer sperren", "autoResize": true, "lineHeight": 1.25}, {"id": "VHZE2TyE3fe1Awwav9eAv", "type": "image", "x": 6070.812891833121, "y": 5971.393821384266, "width": 1185.440685152113, "height": 651.9923768336621, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bnT", "roundness": null, "seed": 1007607790, "version": 92, "versionNonce": 1012338418, "isDeleted": false, "boundElements": null, "updated": 1792223561365, "link": null, "locked": false, "status": "saved", "fileId": "ea71a8658a378ff38552c16ecc4905642a3fb737", "scale": [1, 1], "crop": null}, {"id": "jmks3gtKAr6rOr3-KuZJn", "type": "image", "x": 5992.6438962712255, "y": 6061.92609108539, "width": 375.36532986559496, "height": 864.8620100281614, "angle": 0, "strokeColor": "transparent", "backgroundColor": "#b2f2bb", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": "bnU", "roundness": null, "seed": 345777582, "version": 256, "versionNonce": 1972787182, "isDeleted": false, "boundElements": null, "updated": 1792223573127, "link": null, "locked": false, "status": "s