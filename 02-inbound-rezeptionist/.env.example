# Vorlage für die .env im Projektordner. Claude legt die echte .env in Schritt „Konten einrichten“ an.
# Die .env gehört in die .gitignore und nie ins Git.

# ElevenLabs: elevenlabs.io, unten links Profil, API Keys (mit EU-Workspace auf eu.residency.elevenlabs.io)
ELEVENLABS_API_KEY=

# Supabase: Access Token für Claude unter supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Supabase: Trägt Claude selbst ein, wenn es das Projekt anlegt (Project Settings, API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Requesty: requesty.ai, Dashboard, API Keys (für Embeddings mit text-embedding-3-small)
REQUESTY_API_KEY=

# Firecrawl: firecrawl.dev, Dashboard, API Keys
FIRECRAWL_API_KEY=

# Mistral: console.mistral.ai, API Keys (nur für den optionalen PDF-Upload mit Mistral OCR)
MISTRAL_API_KEY=

# n8n: Adresse deiner Instanz, zum Beispiel https://deinname.app.n8n.cloud
N8N_API_URL=<DEINE_N8N_URL>
# n8n: In deiner Instanz unter Settings, n8n API einen Key erzeugen
N8N_API_KEY=

# Twilio braucht keinen Eintrag hier: Claude meldet dich mit „twilio login“ an.
# Weitere Werte, die Claude in späteren Schritten selbst ergänzt (zum Beispiel der Key, der die
# Werkzeug-Webhooks absichert, oder die Secrets der ElevenLabs-Webhooks), kommen ebenfalls in die .env.
