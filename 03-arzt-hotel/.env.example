# Vorlage für die .env im Projektordner. Kopieren nach .env, Werte selbst eintragen.
# Die .env gehört in die .gitignore und wird nie committet oder im Chat geteilt.

# OpenAI Platform: unter "API keys" anlegen. Das Konto braucht Zugriff auf gpt-live-1 und gpt-6-luna.
OPENAI_API_KEY=

# Praxissoftware (nur Teil B, Arzt): Login deines eigenen Testkontos.
# Das Konto darf keine Zwei-Faktor-Anmeldung haben, sonst klappt der Login aus dem Code nicht.
PRAXIS_EMAIL=
PRAXIS_PASSWORD=
